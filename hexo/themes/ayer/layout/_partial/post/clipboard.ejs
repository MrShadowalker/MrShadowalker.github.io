<script>
  function wait(callback, seconds) { window.setTimeout(callback, seconds); }
  (function () {
    var initCopyCode = function () {
      var copyHtml = '<button class="btn-copy" data-clipboard-snippet=""><i class="ri-file-copy-2-line"></i><span>COPY</span></button>';
      $('.highlight .code pre').before(copyHtml);
      $('.article pre code').before(copyHtml);
      var clipboard = new ClipboardJS('.btn-copy', {target: function (trigger) { return trigger.nextElementSibling; }});
      clipboard.on('success', function (event) {
        var button = $(event.trigger), icon = button.find('i'), label = button.find('span');
        button.addClass('copied'); icon.removeClass('ri-file-copy-2-line').addClass('ri-checkbox-circle-line'); label.text('COPIED');
        wait(function () { icon.removeClass('ri-checkbox-circle-line').addClass('ri-file-copy-2-line'); label.text('COPY'); }, 2000);
      });
      clipboard.on('error', function (event) {
        event.clearSelection(); var button = $(event.trigger), icon = button.find('i'), label = button.find('span');
        button.addClass('copy-failed'); icon.removeClass('ri-file-copy-2-line').addClass('ri-time-line'); label.text('COPY FAILED');
        wait(function () { icon.removeClass('ri-time-line').addClass('ri-file-copy-2-line'); label.text('COPY'); }, 2000);
      });
    };
    initCopyCode();
  }());
</script>
